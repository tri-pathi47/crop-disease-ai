# Copy to .env and fill in what you have. Missing keys fall back to demo data.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://inno:inno@db:5432/innosphere
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=/srv/uploads

# Weather — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Copernicus Data Space (Sentinel-2) — https://dataspace.copernicus.eu
COPERNICUS_USER=
COPERNICUS_PASSWORD=

# Bhashini Indian-language speech — https://bhashini.gov.in
BHASHINI_API_KEY=

# Optional knowledge graph
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
